<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.latinosmc</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app</artifactId>
  <name>LatinosMC :: app</name>
  <description>Ensamblador: unico artefacto desplegable. Depende de todos los modulos.</description>

  <dependencies>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>identity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>organizations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>servers</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>voting</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>trust</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>ranking</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>com.latinosmc</groupId>
      <artifactId>billing</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      JDBC en lugar de JPA. Los modulos criticos (votos, antifraude, ledger)
      dependen de SQL preciso: inserciones que se apoyan en indices unicos para
      la idempotencia, consultas de ventana con indices parciales. Con JPA de por
      medio, esa precision se pierde detras de una capa que decide por su cuenta
      cuando y como emitir el SQL.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Cache local para el control de trafico. Caffeine y no Valkey: mientras
         haya una sola instancia, un servicio menos que operar (Requisito 08). -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- SMTP. Universal a proposito: funciona con Resend, Brevo, SES, Mailgun,
         Zoho y cualquier otro. Usar la API propia de un proveedor ataria el
         codigo a el, y cambiar de proveedor de correo es algo que pasa. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Tests de arquitectura: verifican las reglas del ADR-0001 en CI -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.latinosmc.app.LatinosMcApplication</mainClass>
        </configuration>
      </plugin>

      <!--
        Permite ejecutar y validar migraciones sin arrancar la aplicacion.
        Util en CI: se comprueba que el esquema aplica limpio antes de desplegar.
      -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <url>${env.DB_URL}</url>
          <user>${env.DB_USER}</user>
          <password>${env.DB_PASSWORD}</password>
          <locations>
            <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
          </locations>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
