<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>com.latinosmc</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>LatinosMC Backend</name>
  <description>Plataforma de votaciones y ranking para servidores de Minecraft</description>

  <!--
    Monolito modular (ADR-0001).

    Cada modulo de dominio es un modulo Maven independiente. Esto da
    aislamiento en tiempo de compilacion: un modulo no puede importar
    las clases internas de otro aunque quiera, porque no esta en su
    classpath. Es la garantia mas fuerte disponible, y es lo que hace
    que "extraible a servicios" signifique algo real.

    Regla: los modulos de dominio NO se dependen entre si. Se comunican
    por eventos o por interfaces publicas declaradas en 'shared'.
    Solo 'app' depende de todos: es quien los ensambla.
  -->
  <modules>
    <module>shared</module>
    <module>identity</module>
    <module>organizations</module>
    <module>servers</module>
    <module>voting</module>
    <module>trust</module>
    <module>ranking</module>
    <module>delivery</module>
    <module>billing</module>
    <module>app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <archunit.version>1.3.0</archunit.version>
    <uuid-creator.version>6.0.0</uuid-creator.version>
    <spotless.version>2.44.0</spotless.version>
    <jacoco.version>0.8.16</jacoco.version>
    <pitest.version>1.30.2</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>

    <!--
      JaCoCo escribe aqui su agente. Se declara vacia para que surefire arranque
      igual cuando JaCoCo no corre (por ejemplo con -Djacoco.skip=true).
    -->
    <argLine/>

    <!--
      Suelo de cobertura de lineas del modulo. En cero, JaCoCo solo informa.
      Los modulos criticos (identity, voting, trust, billing) lo suben en su
      propio pom.xml: ahi el suelo si hace fallar 'mvn verify'.
    -->
    <cobertura.suelo>0.00</cobertura.suelo>

    <!--
      PIT solo muta los modulos criticos: cada uno pone esta propiedad en false.
      Mutar los diez modulos tardaria demasiado para lo que aporta.
    -->
    <mutacion.omitir>true</mutacion.omitir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>organizations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>servers</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>voting</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>trust</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>ranking</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>delivery</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.latinosmc</groupId>
        <artifactId>billing</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.github.f4b6a3</groupId>
        <artifactId>uuid-creator</artifactId>
        <version>${uuid-creator.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Mockito llega de forma transitiva con spring-boot-starter-test, pero se
      declara explicitamente porque surefire solo sabe resolver la ruta del jar
      (${org.mockito:mockito-core:jar}) para dependencias directas. Esa ruta la
      necesita el -javaagent configurado mas abajo.
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Mockito necesita declararse como agente Java. Las versiones recientes
          del JDK avisan de que la auto-adjuncion dejara de funcionar, y en un
          JDK futuro los tests dejarian de arrancar sin previo aviso.
          Configurarlo ahora cuesta tres lineas; descubrirlo el dia de una
          actualizacion, una tarde.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- @{argLine} se resuelve al ejecutar: es el agente de JaCoCo. -->
            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>

        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <skip>${mutacion.omitir}</skip>
            <targetClasses>
              <param>com.latinosmc.${project.artifactId}.*</param>
            </targetClasses>
            <targetTests>
              <param>com.latinosmc.${project.artifactId}.*</param>
            </targetTests>
            <outputFormats>
              <param>HTML</param>
              <param>XML</param>
            </outputFormats>
            <!-- Sin fecha en la carpeta: el informe queda siempre en target/pit-reports. -->
            <timestampedReports>false</timestampedReports>
            <threads>4</threads>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>

      <!--
        Publica la ruta de cada dependencia como propiedad
        (${org.mockito:mockito-core:jar}). Sin esta ejecucion, esa expresion
        llega literal al comando de arranque de la JVM y los tests no levantan.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>rutas-de-dependencias</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Cobertura (ADR-0032). Mide todos los modulos y deja el informe en
        target/site/jacoco. El suelo solo falla donde 'cobertura.suelo' es mayor
        que cero. La cobertura dice que lineas se ejecutaron, no que las pruebas
        comprueben algo: eso lo mide la mutacion (perfil 'mutacion').
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>informe</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>suelo</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.suelo}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Pruebas de mutacion con PIT (ADR-0032). No corre en 'mvn verify' normal:
        mvn -B -Pmutacion -pl voting -am verify
      PIT cambia el codigo (invierte una condicion, quita una llamada) y vuelve a
      ejecutar las pruebas. Un mutante que sobrevive es un cambio de comportamiento
      que ninguna prueba nota. El informe queda en <modulo>/target/pit-reports.
    -->
    <profile>
      <id>mutacion</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>mutacion</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
