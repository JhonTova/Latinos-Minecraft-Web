# =============================================================================
# Copia este archivo a .env y rellena los valores.
#
#   cp .env.example .env
#
# El archivo .env NUNCA se sube al repositorio: contiene secretos.
# =============================================================================

# --- Perfil -------------------------------------------------------------------
# staging = los códigos de verificación salen en los logs, sin proveedor de correo.
# prod    = exige proveedor de correo real; no arranca sin él.
PERFIL=staging

# --- Base de datos -----------------------------------------------------------
DB_NAME=latinosmc
DB_USER=latinosmc

# Genera una contraseña larga y aleatoria. No reutilices ninguna que hayas
# escrito antes en un chat, un correo o un ticket.
#   openssl rand -base64 32
DB_PASSWORD=

# --- Clave de hash de identidades --------------------------------------------
# ⚠️ ESTA ES LA MÁS IMPORTANTE DE TODAS. Genérala UNA vez y guárdala como
# guardarías la contraseña del banco.
#
#   openssl rand -base64 48
#
# Si esta clave cambia, TODOS los hashes de identidad dejan de coincidir: se
# pierde de golpe la ventana de voto y el historial antifraude de todos los
# usuarios. No hay forma de recuperarlo.
#
# Mínimo 32 caracteres. La aplicación se niega a arrancar en producción si
# detecta el valor de desarrollo.
LATINOSMC_IDENTITY_PEPPER=

# --- Red ---------------------------------------------------------------------
# URL pública del sitio. Se usa para CORS (solo este origen puede llamar a la
# API desde un navegador) y para el enlace que ve el jugador tras escribir /votar.
SITIO_URL=https://latinosmc.com

# URL pública de la API. Debe coincidir EXACTAMENTE con la que registres en
# Google y Discord, o rechazarán el acceso.
API_URL_PUBLICA=https://api.latinosmc.com

# Puertos SOLO en 127.0.0.1 — los publica el Nginx del host, no Docker.
# Cámbialos si alguno se te ocupa: comprueba con `sudo ss -tlnp | grep :PUERTO`
API_PUERTO=8091
WEB_PUERTO=3010

# --- Memoria ------------------------------------------------------------------
# Total ~1,7 GB. Súbelo si el VPS va sobrado; bájalo si va justo.
#
# Sin estos límites, la JVM vería la RAM del HOST entero y reservaría el 75% de
# toda la máquina, matando al resto de servicios.
API_MEMORIA=768m
WEB_MEMORIA=384m
DB_MEMORIA=512m

# --- PayPal (recomendado) -----------------------------------------------------
# Más fácil de arrancar que Stripe: cuenta, dos claves y listo. Sin verificación
# de empresa ni datos fiscales por adelantado.
#
# Si están rellenos PayPal y Stripe a la vez, gana PayPal.
#
# 1. Entra en https://developer.paypal.com y accede con tu cuenta de PayPal
# 2. Apps & Credentials → pestaña *Sandbox* → Create App (tipo Merchant)
#    OJO: las claves de Sandbox y las de Live son distintas y no valen unas por
#    otras. Empieza en Sandbox: PayPal te da compradores falsos con dinero falso.
# 3. Copia "Client ID" y "Secret"
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# 4. En la misma app: Webhooks → Add Webhook
#    URL:     https://api.tu-dominio.com/api/v1/pagos/webhook
#    Eventos: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED,
#             PAYMENT.CAPTURE.REVERSED
#    Copia el ID que aparece después (empieza por WH-)
#
# Sin esto, un cliente que pague y cierre el navegador antes de volver a la web
# se queda sin su espacio destacado y hay que arreglarlo a mano.
PAYPAL_WEBHOOK_ID=

# sandbox = dinero falso. live = dinero real. Cambia a live cuando hayas probado
# el flujo entero y hayas puesto las claves de la pestaña Live.
PAYPAL_MODO=sandbox

# --- Correo (necesario para verificar cuentas) --------------------------------
# Sin esto, los códigos de verificación salen por los logs del contenedor en vez
# de por correo. Sirve para probar, no para producción: nadie puede registrarse.
#
# Vale cualquier proveedor que hable SMTP. Con Brevo (gratis, 300 correos/día):
#
# 1. Cuenta en https://www.brevo.com
# 2. Verifica tu dominio: Senders & Domains → Domains → Add a domain
# 3. Brevo te da unos registros DNS. Créalos en Cloudflare tal cual, con la nube
#    GRIS (solo DNS), no naranja. Son tres: DKIM, DMARC y uno de verificación.
# 4. SMTP & API → SMTP → ahí están el servidor, el puerto, el login y la clave
#
# ⚠️ El remitente tiene que ser una dirección DE TU DOMINIO y verificada. Poner
# un @gmail.com aquí manda todos los correos directos a spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=no-responder@latinosmc.com
CORREO_NOMBRE=LatinosMC

# --- Stripe (opcional) --------------------------------------------------------
# Si lo dejas vacío, se usa cobro manual: el pedido queda pendiente y tú lo
# confirmas desde el panel. Perfectamente válido para empezar.
#
# 1. Crea cuenta en https://dashboard.stripe.com
# 2. Empieza en MODO PRUEBA (interruptor arriba a la derecha). Las claves de
#    prueba empiezan por sk_test_ y hay tarjetas falsas con las que recorres el
#    flujo entero sin mover un euro. La tarjeta 4242 4242 4242 4242 siempre
#    funciona.
# 3. Developers → API keys → copia la "Secret key"
STRIPE_SECRET_KEY=

# 4. Developers → Webhooks → Add endpoint
#    URL:     https://api.tu-dominio.com/api/v1/pagos/webhook
#    Eventos: checkout.session.completed, charge.refunded
#    Copia el "Signing secret" (empieza por whsec_)
#
# ⚠️ SIN ESTE SECRETO los cobros se crean pero NUNCA se confirman solos. Es un
# fallo silencioso: el cliente paga, Stripe cobra, y en tu web no pasa nada.
STRIPE_WEBHOOK_SECRET=

# --- Acceso con Google y Discord (opcional) -----------------------------------
# Si los dejas vacíos, los botones simplemente no aparecen y el registro por
# correo funciona igual.
#
# Google:  console.cloud.google.com → APIs y servicios → Credenciales
# Discord: discord.com/developers/applications → OAuth2
#
# URL de retorno a registrar en cada uno (un carácter de diferencia y falla):
#   https://api.latinosmc.com/api/v1/auth/oauth/google/callback
#   https://api.latinosmc.com/api/v1/auth/oauth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
